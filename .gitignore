# Not part of this repository: an older app with its own repo, its old backend, and a build output.
/clinics/
/clinics_backend/
/tabebak_admin_dist/

# Laravel runtime files: sessions, logs and caches can hold private data.
/tabebak_backend/storage/framework/cache/data/
/tabebak_backend/storage/framework/sessions/*
/tabebak_backend/storage/framework/testing/*
/tabebak_backend/storage/framework/views/*
/tabebak_backend/storage/logs/*
!/tabebak_backend/storage/framework/sessions/.gitignore
!/tabebak_backend/storage/framework/testing/.gitignore
!/tabebak_backend/storage/framework/views/.gitignore
!/tabebak_backend/storage/logs/.gitignore

# Signing keys, wherever they end up.
*.jks
*.keystore
key.properties

# Release bundle: built output, large, rebuilt from the code.
/google_play/*.aab

# Editor settings and Windows clutter.
.vscode/
Thumbs.db
